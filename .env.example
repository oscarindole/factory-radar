# ---------------------------------------------------------------------------
# La API se conecta SIEMPRE como fr_app: no es propietario de las tablas y no
# es superusuario. Conectarse como propietario anula toda la RLS en silencio,
# porque el propietario salta las politicas salvo FORCE (ver db/09-rls.sql).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://fr_app:cambiame@localhost:5432/factory_radar

# Conexion aparte para los trabajos de fondo (rollup, motor de eventos). Necesita
# mas permisos que la API porque fr_rollup() lee `measurement`, que fr_app no ve.
# Separarlas es lo que evita que una inyeccion en la API alcance el dato crudo
# de todos los inquilinos.
DATABASE_URL_JOBS=postgres://postgres:cambiame@localhost:5432/factory_radar

PUERTO=3001
ENTORNO=desarrollo

# Clave de firma de las sesiones. Sin valor por defecto a proposito.
JWT_SECRETO=

# ---------------------------------------------------------------------------
# IA. El proveedor se elige aqui, nunca en el codigo de negocio: precio y
# modelos se mueven cada trimestre, y habra clientes que exijan que el dato no
# salga de su infraestructura.
# ---------------------------------------------------------------------------
IA_PROVEEDOR=claude
IA_MODELO_RAZONA=claude-opus-5
IA_MODELO_RAPIDO=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Tope mensual por defecto, en euros. Se puede subir por empresa en la tabla
# `company`. Al 80% se avisa; al 100% se degrada a modelo barato, nunca corte
# seco: un Copilot que deja de contestar a mitad de mes es una baja.
IA_PRESUPUESTO_EUR=30
